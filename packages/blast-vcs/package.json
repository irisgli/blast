{
  "name": "@blast/vcs",
  "version": "0.1.0",
  "private": true,
  "description": "Everything that talks to git and GitHub: reading a change, posting a brief, and the blast command a pipeline runs.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "blast": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "blast-dist": "./dist/index.js",
      "eve-source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@blast/adapters": "workspace:*",
    "@blast/brief": "workspace:*",
    "@blast/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
