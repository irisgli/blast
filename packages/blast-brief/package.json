{
  "name": "@blast/brief",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence collection, brief rendering, and remediation derivation. The engine the agent and the web app share.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "eve-source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "test": "pnpm run test:unit && pnpm run test:agent",
    "test:agent": "vitest run --config vitest.agent.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@blast/adapters": "workspace:*",
    "@blast/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
