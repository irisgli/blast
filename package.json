{
  "name": "blast-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for blast, a pre-ship impact brief agent built on eve.",
  "homepage": "https://github.com/irisgli/blast",
  "type": "module",
  "scripts": {
    "blast": "node --conditions=blast-dist packages/blast-vcs/dist/cli.js",
    "build": "turbo run build --filter='./packages/*'",
    "changeset": "changeset",
    "dev": "eve dev",
    "fmt": "oxfmt",
    "lint": "oxlint --fix",
    "test": "pnpm test:unit && pnpm test:contract && pnpm test:agent",
    "test:agent": "turbo run test:agent",
    "test:contract": "turbo run test:contract",
    "test:unit": "turbo run test:unit",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.agent.json --noEmit"
  },
  "dependencies": {
    "@blast/adapters": "workspace:*",
    "@blast/brief": "workspace:*",
    "@blast/core": "workspace:*",
    "@blast/vcs": "workspace:*",
    "eve": "0.64.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "catalog:",
    "just-bash": "^3.4.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "turbo": "2.11.3",
    "typescript": "catalog:",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.5.1"
}
